{
  "name": "eve-adaptive-study-coach",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev --no-default-extensions",
    "eval": "eve eval --strict",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "inspect": "node scripts/inspect-course.ts",
    "reset-progress": "node scripts/reset-progress.ts"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "eve": "^0.80.1",
    "guarded-fetch": "0.1.3",
    "just-bash": "^3.6.0",
    "node-html-parser": "9.0.4",
    "unpdf": "1.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "description": "A terminal Eve agent that coaches learners from public course websites, with code-enforced source boundaries."
}
